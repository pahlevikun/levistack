meta {
  name: create-valid
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/archive-jobs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "source": {
      "collection": "demo-records"
    },
    "label": null
  }
}

script:post-response {
  if (res.status === 202 && res.body.id) {
    bru.setEnvVar("jobId", String(res.body.id));
  }
}

tests {
  test("Declared HTTP status", function () { expect(res.status).to.equal(202); });
}

docs {
  A valid source and explicit null label queue a job. Use a token with archives:write.

  Evidence: normative synthetic contract demo-1. This request and its assertions have not been run.
  The example.test host is illustrative. Replace it only with an authorized test service. No login or refresh endpoint is defined.

  Declared response: HTTP 202 Accepted.
  Caller action: Read the returned job ID; acceptance is not completion.

  Success body follows Job or the list envelope in the normative contract. All Job fields remain present. Label presence and nullability differ between request and response.
}

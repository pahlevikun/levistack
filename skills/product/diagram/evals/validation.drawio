<mxfile host="app.diagrams.net">
  <diagram id="validation-page" name="Request validation">
    <mxGraphModel dx="800" dy="400" grid="1" gridSize="10" page="1" pageWidth="800" pageHeight="400">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="client" value="Client" style="rounded=1;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="gate" value="Valid?" style="rhombus;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="store" value="Store" style="rounded=1;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="reject" value="Reject" style="rounded=1;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="submit" value="submit" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" parent="1" source="client" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" parent="1" source="gate" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="no" value="no" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" parent="1" source="gate" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
